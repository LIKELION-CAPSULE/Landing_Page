# VITE_ values are included in the public build. Use public project tokens only.
# Mixpanel — Project Settings > Project Token (optional)
VITE_MIXPANEL_TOKEN=
# Empty uses the US region. EU projects: https://api-eu.mixpanel.com
VITE_MIXPANEL_API_HOST=

# App login URL. Empty falls back to https://capsule-front-web.vercel.app/login
VITE_APP_URL=
