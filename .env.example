# 전부 선택 사항. 비어 있으면 분석·저장을 건너뛰고 화면 흐름만 동작한다.
# ⚠️ VITE_ 접두사가 붙은 값은 빌드 결과에 그대로 들어간다 — 공개해도 되는 키만 넣을 것.
#    Supabase service_role 키, PostHog 개인 API 키는 절대 여기 넣지 않는다.

# PostHog — 프로젝트 설정 > Project API key (phc_... 로 시작, 공개용)
VITE_POSTHOG_KEY=
# 기본값 https://us.i.posthog.com. EU 리전이면 https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Supabase — 프로젝트 설정 > API. anon(public) 키만. RLS 가 INSERT 외 모든 접근을 막는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
