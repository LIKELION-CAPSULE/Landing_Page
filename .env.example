# VITE_ values are included in the public build. Use public project tokens only.
# Mixpanel — Project Settings > Project Token (optional)
VITE_MIXPANEL_TOKEN=
# Empty uses the US region. EU projects: https://api-eu.mixpanel.com
VITE_MIXPANEL_API_HOST=

# App address (absolute http/https). A bare origin opens its /login. From 2026-12-01 00:00 KST the CTA links here;
# empty or invalid keeps 「오픈 준비 중」 in production (dev/preview fall back to https://capsule-front-web.vercel.app/login).
VITE_APP_URL=

# Search console ownership tags (optional). Each <meta> is added only when its value is set.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
